# 默认使用真实管理接口；本地演示时才显式改为 mock
VITE_API_MODE=real

# 真实接口默认走同源 /api/admin/v1，Vite 开发服务器会代理 /api
VITE_API_BASE_URL=/api/admin/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Keycloak/OIDC Authorization Code + PKCE
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/veriscan-local
VITE_OIDC_CLIENT_ID=veriscan-admin
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
