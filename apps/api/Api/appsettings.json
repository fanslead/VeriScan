{
  "ConnectionStrings": {
    "Redis": null
  },
  "Database": {
    "AutoMigrate": false
  },
  "Authentication": {
    "Admin": {
      "Audience": "veriscan-api",
      "RequireHttpsMetadata": true,
      "ValidateAudience": true,
      "RequiredRole": "veriscan-admin"
    }
  },
  "Security": {
    "ApiKey": {
      "PepperVersion": "v1",
      "MaximumActiveKeys": 5,
      "MaximumLifetimeDays": 365
    },
    "AiCredentials": {
      "MasterKey": ""
    }
  },
  "ExternalAi": {
    "AllowedHosts": [],
    "AllowedPorts": [443],
    "ConnectTimeoutMs": 2000,
    "MaximumResponseBytes": 1048576,
    "MaximumConcurrentCallsPerBatch": 4
  },
  "Observability": {
    "ExcludeHealthChecks": true,
    "HealthPath": "/healthz",
    "Otlp": {
      "Enabled": false,
      "Endpoint": null,
      "Protocol": "grpc"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
