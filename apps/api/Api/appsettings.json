{
  "ConnectionStrings": {
    "Redis": null
  },
  "Database": {
    "AutoMigrate": false
  },
  "Moderation": {
    "Idempotency": {
      "OperationRetentionHours": 24
    }
  },
  "Authentication": {
    "Admin": {
      "Audience": "veriscan-api",
      "RequireHttpsMetadata": true,
      "ValidateAudience": true,
      "RequiredRole": "veriscan-admin"
    }
  },
  "Security": {
    "ApiKey": {
      "PepperVersion": "v1",
      "MaximumActiveKeys": 5,
      "MaximumLifetimeDays": 365
    },
    "AiCredentials": {
      "MasterKey": ""
    },
    "ModerationDigests": {
      "KeyVersion": "v1"
    },
    "ContentProtection": {
      "KeyRingPath": ""
    }
  },
  "ExternalAi": {
    "AllowedHosts": [],
    "AllowedPorts": [443],
    "ConnectTimeoutMs": 2000,
    "MaximumResponseBytes": 1048576,
    "MaximumRequestTimeoutMs": 120000,
    "MaximumAttempts": 3,
    "RetryBaseDelayMs": 100,
    "RetryMaximumDelayMs": 5000,
    "RetryUseJitter": true,
    "CircuitFailureRatio": 0.5,
    "CircuitMinimumThroughput": 20,
    "CircuitSamplingDurationSeconds": 30,
    "CircuitBreakDurationSeconds": 30,
    "MaximumConcurrentCallsPerBatch": 4,
    "MaximumSynchronousBatchMs": 30000
  },
  "WebhookProvider": {
    "Enabled": false,
    "ServerUrl": "",
    "AuthToken": "",
    "SecretRotationGraceSeconds": 86400,
    "TimeoutMilliseconds": 15000
  },
  "WebhookPublication": {
    "Worker": {
      "Enabled": true,
      "BatchSize": 50,
      "LeaseSeconds": 60,
      "PollDelayMilliseconds": 500,
      "MaximumPublishAttempts": 8,
      "MaximumFailureBackoffSeconds": 300,
      "TestPollDelayMilliseconds": 1000,
      "TestTimeoutSeconds": 30
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "PathPrefix": "/api/v1/moderation",
    "GlobalPermitLimit": 2000,
    "GlobalWindowSeconds": 1,
    "GlobalQueueLimit": 0,
    "GlobalConcurrencyLimit": 64,
    "ApplicationPermitLimit": 500,
    "ApplicationWindowSeconds": 1,
    "ApplicationQueueLimit": 16,
    "ApiKeyPermitLimit": 120,
    "ApiKeyWindowSeconds": 1,
    "ApiKeyQueueLimit": 8,
    "ApplicationConcurrencyLimit": 64,
    "ApplicationConcurrencyQueueLimit": 16,
    "ApiKeyConcurrencyLimit": 16,
    "ApiKeyConcurrencyQueueLimit": 4,
    "DefaultRetryAfterSeconds": 1,
    "MaximumRetryAfterSeconds": 60
  },
  "Observability": {
    "ExcludeHealthChecks": true,
    "HealthPath": "/healthz",
    "Otlp": {
      "Enabled": false,
      "Endpoint": null,
      "Protocol": "grpc"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
