# 仅用于本地开发，请复制为 infra/.env 后再按需修改，不得用于生产环境。
COMPOSE_PROJECT_NAME=veriscan

# PostgreSQL 本地开发连接参数。
POSTGRES_DB=veriscan
POSTGRES_USER=veriscan
POSTGRES_PASSWORD=veriscan-local-postgres-change-me
POSTGRES_KEYCLOAK_DB=veriscan_keycloak
POSTGRES_PORT=5432

# Redis 本地开发连接参数。
REDIS_PASSWORD=veriscan-local-redis-change-me
REDIS_PORT=6379

# Keycloak 本地开发参数。管理员账号只用于本机初始化和管理控制台。
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=veriscan-local-keycloak-change-me
KEYCLOAK_REALM=veriscan-local
ADMIN_WEB_ORIGIN=http://localhost:5173

# VeriScan API 与管理后台本地端口。
API_PORT=5000
ADMIN_PORT=5173
VERISCAN_IMAGE_TAG=local

# 仅用于本地开发，四类密钥必须彼此独立。生产环境请改由 Secret/KMS 注入。
API_KEY_PEPPER=veriscan-local-api-key-pepper-change-me
CONTENT_DIGEST_PEPPER=veriscan-local-content-digest-pepper-change-me
IDEMPOTENCY_DIGEST_PEPPER=veriscan-local-idempotency-digest-pepper-change-me
AI_CREDENTIAL_MASTER_KEY=dmVyaXNjYW4tbG9jYWwtYWktbWFzdGVyLWtleS0wMDE=

# 本地初始工作区管理员。仅由 realm 首次导入创建。
VERISCAN_ADMIN_USERNAME=veriscan-admin
VERISCAN_ADMIN_PASSWORD=veriscan-local-admin-change-me
