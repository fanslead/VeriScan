{
  "realm": "veriscan-local",
  "enabled": true,
  "displayName": "明鉴本地开发域",
  "displayNameHtml": "<strong>明鉴</strong> 本地开发域",
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "clients": [
    {
      "clientId": "veriscan-admin",
      "name": "明鉴管理后台（本地）",
      "description": "仅用于本地开发的管理后台 OIDC 客户端",
      "rootUrl": "http://localhost:5173",
      "adminUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "veriscan-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "veriscan-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "veriscan-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "veriscan-api",
      "name": "明鉴 API（本地）",
      "description": "管理后台访问的本地 API 资源标识",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect"
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "veriscan-admin",
        "description": "本地开发管理员，可管理应用、规则和配置"
      },
      {
        "name": "veriscan-operator",
        "description": "本地开发运营人员，可查看和操作审核数据"
      },
      {
        "name": "veriscan-auditor",
        "description": "本地开发审计人员，只读查看审计与统计"
      },
      {
        "name": "veriscan-viewer",
        "description": "只读查看应用、记录、规则和模型配置"
      },
      {
        "name": "veriscan-ruleset-editor",
        "description": "创建、编辑和校验规则草稿"
      },
      {
        "name": "veriscan-ai-config-editor",
        "description": "创建、编辑和测试模型配置草稿"
      },
      {
        "name": "veriscan-publisher",
        "description": "发布、激活、回滚和归档配置版本"
      },
      {
        "name": "veriscan-platform-admin",
        "description": "平台级管理员，可执行全部治理操作"
      }
    ]
  },
  "users": [
    {
      "username": "veriscan-admin",
      "enabled": true,
      "email": "veriscan-admin@localhost.invalid",
      "emailVerified": true,
      "firstName": "明鉴",
      "lastName": "管理员",
      "credentials": [
        {
          "type": "password",
          "value": "veriscan-local-admin-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "veriscan-admin",
        "veriscan-operator",
        "veriscan-auditor",
        "veriscan-viewer",
        "veriscan-ruleset-editor",
        "veriscan-ai-config-editor",
        "veriscan-publisher",
        "veriscan-platform-admin"
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins"
  ]
}
